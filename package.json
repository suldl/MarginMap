{
  "name": "marginmap",
  "productName": "MarginMap",
  "version": "0.5.0",
  "description": "Read PDFs, excerpt into mind maps, review with flashcards — a MarginNote-style study app for Windows.",
  "main": "dist-electron/main.js",
  "private": true,
  "author": "MarginMap contributors",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "test:e2e": "npm run build && node tests/smoke.mjs"
  },
  "repository": "github:suldl/MarginMap",
  "build": {
    "appId": "app.marginmap.desktop",
    "electronDist": "node_modules/electron/dist",
    "productName": "MarginMap",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "suldl",
        "repo": "MarginMap",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.12",
    "idb-keyval": "^6.3.0",
    "katex": "^0.16.47",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
